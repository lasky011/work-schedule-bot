# Пример конфигурации TNG Alice. Скопируй в .env и заполни своими значениями:
#   cp .env.example .env
# Файл .env в .gitignore — реальные секреты не коммитятся.

# --- Обязательные для основного бота (bot.py) ---
# Токен бота от @BotFather.
BOT_TOKEN=123456:your-telegram-bot-token
# Строка подключения к PostgreSQL.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Обязательные для админ-бота (admin_bot.py) ---
# Токен отдельного админ-бота от @BotFather.
ADMIN_BOT_TOKEN=654321:your-admin-bot-token
# Telegram user id админов через запятую (например: 111111111,222222222).
ADMIN_IDS=

# --- Google Sheets (источник графика) ---
# ID таблицы с графиком. Есть значение по умолчанию в app_config.py,
# переопредели для тестовой таблицы.
SHEET_ID=1bRuO870pDBf6O-kXJ1O342SmxmjZgpsiacM2aPOJm9Y

# --- Необязательные (значения ниже — дефолты) ---
# Часовой пояс приложения.
APP_TIMEZONE=Europe/Moscow
# Включить встроенный HTTP-сервер Mini App (1/true/yes).
MINIAPP_ENABLED=
# Порт Mini App.
MINIAPP_PORT=8080
# Публичный URL Mini App (для кнопки-ссылки в боте).
MINIAPP_URL=
# Как часто (сек) prod/test подтягивают gid из sheet_periods.
SHEET_PERIODS_REFRESH_SECONDS=300
